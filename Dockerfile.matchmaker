FROM rust:1.85-bookworm AS builder

WORKDIR /app
COPY . .
RUN cargo build --release --no-default-features --bin matchmaker

FROM debian:bookworm-slim

RUN useradd --system --uid 10001 --create-home forge \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/matchmaker /usr/local/bin/matchmaker

USER forge
ENV MATCHMAKER_BIND=0.0.0.0:7000
ENV RELAY_BIND=0.0.0.0:7001

EXPOSE 7000/udp
EXPOSE 7001/udp

ENTRYPOINT ["/usr/local/bin/matchmaker"]
